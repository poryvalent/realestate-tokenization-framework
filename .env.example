# AcreSync configuration template.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain a real value.
#
# Grouped by the milestone that first needs each group. Nothing below M1 is
# required to run the allocation engine, which is a pure function by design.

# ---------------------------------------------------------------------------
# Always
# ---------------------------------------------------------------------------

# LOCAL or SEPOLIA_SIM. Written into every on-chain anchor and every admin action
# so a simulated record can never be mistaken for a live one.
ACRESYNC_ENVIRONMENT=LOCAL

ACRESYNC_HTTP_ADDR=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Database (M0 migrations, M5 onward at runtime)
# ---------------------------------------------------------------------------

# Local docker:    postgres://postgres:postgres@127.0.0.1:55432/acresync
# Supabase:        use the connection string from Project Settings > Database.
#                  Prefer the pooled connection for the orchestrator.
ACRESYNC_DATABASE_URL=

# ---------------------------------------------------------------------------
# Investor anchor pepper (M5)
# ---------------------------------------------------------------------------

# Identifier of the KMS key used to HMAC investor anchors. Destroying this key is
# the only way to honour a DPDP erasure request against data already anchored on
# an immutable ledger, so it must be a real KMS key in anything but local dev.
ACRESYNC_ANCHOR_PEPPER_KEY_ID=kms/acresync/pepper/v1

# Local development only. In LOCAL mode the pepper may be supplied directly;
# outside LOCAL the loader refuses to start if this is set, because a pepper in an
# env file is a pepper in a backup.
ACRESYNC_ANCHOR_PEPPER_DEV=

# ---------------------------------------------------------------------------
# Chain (M3)
# ---------------------------------------------------------------------------

# Alchemy, Infura, or any Sepolia RPC. Treated as a secret: provider keys are
# usually embedded in the URL path.
ACRESYNC_CHAIN_RPC_URL=
ACRESYNC_CHAIN_ID=11155111

# Relayer signing key, 0x-prefixed. Generate fresh; never reuse a key that has
# touched mainnet or another project. This key signs every anchor and, by design,
# cannot move value: the contracts custody nothing.
ACRESYNC_RELAYER_PRIVATE_KEY=

# Blocks of confirmation required before any fiat instruction is created.
ACRESYNC_CONFIRMATION_DEPTH=5

# Populated after M3 deployment.
ACRESYNC_ROLES_ADDRESS=
ACRESYNC_BALLOT_ADDRESS=
ACRESYNC_SCHEME_ADDRESS=

# Optional, for contract source verification.
ACRESYNC_ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# IPFS (M5)
# ---------------------------------------------------------------------------

# PINATA or MOCK. MOCK writes to the local filesystem and computes the same
# digest, so the pipeline is exercisable before an account exists.
ACRESYNC_IPFS_PROVIDER=MOCK
ACRESYNC_PINATA_JWT=
ACRESYNC_IPFS_GATEWAY=https://gateway.pinata.cloud

# ---------------------------------------------------------------------------
# Payouts and ASBA (M5)
# ---------------------------------------------------------------------------

# RAZORPAYX_SANDBOX or MOCK.
ACRESYNC_PAYOUT_PROVIDER=MOCK
ACRESYNC_RAZORPAY_KEY_ID=
ACRESYNC_RAZORPAY_KEY_SECRET=
ACRESYNC_RAZORPAY_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------
# KYC (M6)
# ---------------------------------------------------------------------------

# DECENTRO, SETU, or MOCK.
ACRESYNC_KYC_PROVIDER=MOCK
ACRESYNC_KYC_CLIENT_ID=
ACRESYNC_KYC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Web3Auth (M8)
# ---------------------------------------------------------------------------

ACRESYNC_WEB3AUTH_CLIENT_ID=
ACRESYNC_WEB3AUTH_NETWORK=sapphire_devnet
